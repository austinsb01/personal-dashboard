# Neon Postgres connection string (pooled host). Copy from the Neon
# console: Connect > Connection string. Replace with your real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Shared password to access the app (single-user gate). Set your own; min 8 chars.
APP_PASSWORD="change-me"
# Secret used to sign the session cookie. Use a long random string; min 16 chars.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"

# Optional. IANA time zone used to decide which calendar day is "today"
# (for example America/New_York). Defaults to UTC when unset.
APP_TIME_ZONE="UTC"
